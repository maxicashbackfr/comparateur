# --- Base de données ---------------------------------------------------------
# Neon. Deux endpoints pour le même projet :
#   · DIRECT  (hostname sans -pooler)  → collecteur et migrations.
#     Connexion TCP native, session complète : REFRESH MATERIALIZED VIEW,
#     transactions longues et DDL s'y comportent normalement.
#   · POOLÉ   (hostname avec -pooler)  → le site Next.js, plus tard.
#     Conçu pour beaucoup de connexions courtes ; le pooling par transaction
#     peut casser ce qui dépend de l'état de session, d'où la séparation.
#
# sslmode et channel_binding sont exigés par Neon, ne les retirez pas.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.eu-central-1.aws.neon.tech/maxicash?sslmode=require&channel_binding=require

# Réservé au site (lot L4). Même base, endpoint poolé.
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-XXXX-pooler.eu-central-1.aws.neon.tech/maxicash?sslmode=require&channel_binding=require

# En local, avec `make up` :
# DATABASE_URL=postgresql://maxicash:maxicash@localhost:5432/maxicash

# --- Collecte ----------------------------------------------------------------
# Identité du crawler — DOIT contenir une URL de contact joignable
MAXICASH_USER_AGENT=MaxiCashBot/0.1 (+https://maxicash.fr/bot)

# Politesse : délai minimum entre deux requêtes vers un même hôte, en secondes
MAXICASH_MIN_DELAY=3.0

# Cache HTTP sur disque (développement : évite de retaper le site)
MAXICASH_CACHE_DIR=.httpcache
MAXICASH_CACHE_TTL=86400

# Alerting (optionnel, lot L7)
MAXICASH_SLACK_WEBHOOK=
